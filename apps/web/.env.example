# URL de l'API Go. Vide, l'application vise http://localhost:8787.
LEMLEARN_API_URL=https://qjjemplbz5.execute-api.eu-west-3.amazonaws.com

# Nom du cookie de session attendu par l'API. Elle le choisit selon *son*
# environnement, pas selon celui de cette application : une API en dev ou en
# production pose « __Host-lemlearn_session », une API en local « lemlearn_session ».
# Se tromper de nom donne des 401 sur chaque appel authentifié, sans message.
LEMLEARN_API_COOKIE=__Host-lemlearn_session
