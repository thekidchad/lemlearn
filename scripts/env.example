# Configuration de déploiement. Copiez ce fichier en scripts/.env.dev (ou
# .env.prod) et remplissez-le ; ces fichiers sont ignorés par git.
#
# Ce qui n'est pas ici est dans ~/.lemlearn (ou $LEMLEARN_SECRETS_DIR) : la clé
# de signature vidéo et le secret de bordure, que scripts/deploy.sh fabrique
# tout seul la première fois et ne retouche plus jamais.

# Compte et région. La région porte les données des apprenants : la changer
# après coup ne les déplace pas.
AWS_PROFILE=learnaly
AWS_REGION=eu-west-3

# Adresses de l'équipe lemlearn, séparées par des virgules. Le rôle
# super-admin est recalculé à chaque connexion depuis cette liste : une adresse
# retirée perd l'accès inter-organismes, une adresse ajoutée l'obtient. Une
# liste vide ne retire rien — c'est presque toujours un oubli de déploiement,
# pas une décision.
LEMLEARN_SUPERADMINS=vous@exemple.fr

# Adresse publique du front. Laissez vide sur un compte neuf : le script la
# découvre au premier déploiement et la propage au second.
LEMLEARN_APP_URL=

# Adresse de l'API. Vide, le front prend celle que CDK vient de créer.
LEMLEARN_API_URL=

# Point d'entrée MediaConvert du compte, propre à chaque compte et à chaque
# région. Sans lui, l'encodage vidéo reste en attente sans message.
#   aws mediaconvert describe-endpoints --query 'Endpoints[0].Url'
LEMLEARN_MEDIACONVERT_ENDPOINT=

# Envoi de courriels. Facultatif hors production : sans clé, rien ne part et
# tout reste consultable dans le journal des envois.
RESEND_API_KEY=
LEMLEARN_MAIL_FROM=

# Facturation. Facultatif : un organisme peut être facturé sur devis.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICES=
